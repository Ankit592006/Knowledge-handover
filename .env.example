# =============================================================================
# Knowledge Handover — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values as needed. Never commit real secrets.
# =============================================================================

# --- Application Settings ---
APP_NAME="Knowledge Handover Platform"
APP_ENV="development"
APP_DEBUG="true"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- Database (PostgreSQL + pgvector) ---
# For Docker Compose: postgresql+psycopg://kh_user:kh_dev_password_change_me@db:5432/knowledge_handover
# For local dev/testing fallback: sqlite:///./knowledge_handover_dev.db
DATABASE_URL="postgresql+psycopg://kh_user:kh_dev_password_change_me@localhost:5432/knowledge_handover"
POSTGRES_USER="kh_user"
POSTGRES_PASSWORD="kh_dev_password_change_me"
POSTGRES_DB="knowledge_handover"
POSTGRES_PORT="5432"

# --- Security & Authentication (Argon2 + JWT) ---
JWT_SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_USE_AT_LEAST_32_RANDOM_BYTES_HEX"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# --- Open-Source AI & RAG Configuration ---
# Supported LLM_PROVIDER values: "ollama", "openai_compatible", "deterministic_extractive"
# For out-of-the-box offline/CI execution, "deterministic_extractive" runs without an external LLM server.
# For local Ollama: set LLM_PROVIDER="ollama", LLM_BASE_URL="http://localhost:11434", LLM_MODEL_NAME="qwen2.5:7b-instruct"
# For cloud/Render with open-source LLMs (Groq, Together, OpenRouter, vLLM):
# Set LLM_PROVIDER="openai_compatible", LLM_BASE_URL="https://api.groq.com/openai/v1", LLM_API_KEY="gsk_..."
LLM_PROVIDER="deterministic_extractive"
LLM_BASE_URL="http://localhost:11434"
LLM_API_KEY=""
LLM_MODEL_NAME="qwen2.5:7b-instruct"
LLM_TIMEOUT_SECONDS="45"
LLM_MAX_RETRIES="2"

# Supported EMBEDDING_PROVIDER values: "sentence_transformers", "ollama", "deterministic_hash"
# Note: "deterministic_hash" generates 384-dim vectors via MD5 unigram/bigram feature hashing (lexical token overlap, not neural semantic embeddings).
EMBEDDING_PROVIDER="deterministic_hash"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION="384"

# --- RAG Chunking & File Upload Controls ---
CHUNK_SIZE_CHARS="800"
CHUNK_OVERLAP_CHARS="120"
MAX_UPLOAD_SIZE_BYTES="5242880"

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://localhost:8000"

